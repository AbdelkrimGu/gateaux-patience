# =============================================================================
# Gateaux Patience — environment template
# Copy this file to .env.local and fill in real values.
# Same values go into Netlify → Site settings → Environment variables.
# =============================================================================

# MongoDB Atlas — full SRV connection string, database name in the path
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/gateaux-patience?retryWrites=true&w=majority
MONGODB_DB=gateaux-patience

# AWS S3 (eu-west-3 Paris recommended)
# Variables are prefixed S3_ instead of AWS_ because Netlify reserves AWS_*
# variable names for its own internal use.
S3_REGION=eu-west-3
S3_BUCKET=gateaux-patience-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_MAX_UPLOAD_BYTES=104857600

# Google Gemini AI (free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Admin
ADMIN_PASSWORD=

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostHog analytics (EU cloud). Leave the key empty to disable analytics.
# On Netlify, set it for the PRODUCTION deploy context only, so deploy previews
# don't count as visitors. In PostHog, leave "Cookieless tracking" OFF: the
# site stores nothing on the device anyway (memory-only), and the cookieless
# setting would discard IPs, so no country/city.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Set to 1 to send events from localhost while testing.
NEXT_PUBLIC_POSTHOG_DEBUG=
